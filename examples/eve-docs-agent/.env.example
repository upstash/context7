# Context7 API key from https://context7.com/dashboard. Takes precedence when set.
CONTEXT7_API_KEY=

# Vercel resource ID (store_… or ir_…) for the connected Context7 resource. Required for OIDC.
CONTEXT7_RESOURCE_ID=

# Model access through Vercel AI Gateway. Not needed once the project is linked (`vercel link`).
AI_GATEWAY_API_KEY=
