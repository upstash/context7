# Context7 resource from the Vercel Marketplace integration (its store ID, from the Storage tab).
# `vercel env pull` also writes the VERCEL_OIDC_TOKEN that the token request needs.
CONTEXT7_STORE_ID=

# Or a Context7 API key from https://context7.com/dashboard. A key takes precedence.
CONTEXT7_API_KEY=

# Model access through Vercel AI Gateway. Not needed once the project is linked (`vercel link`).
AI_GATEWAY_API_KEY=
