{
  "name": "@upstash/context7-admin-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Context7 Admin: remote MCP server to manage Context7 teamspaces, libraries, Docs7 sites and Ask sites",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "pnpm exec vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p ui",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx scripts/dev.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "demo:ui": "vite build --config ui/vite.config.ts && vite build --config ui/demo/vite.config.ts && vite preview --config ui/demo/vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upstash/context7.git",
    "directory": "packages/admin-mcp"
  },
  "author": "abdush",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "mcp-handler": "2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hono": "^4.12.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
