# Context7 API
CONTEXT7_API_KEY=
CONTEXT7_API_URL=https://context7.com/api

# MCP HTTP server
RESOURCE_URL=
OAUTH_AUTH_SERVER_URL=
OAUTH_JWKS_URL=
EMA_ISSUER=
AUTH_SERVER_URL=
OPENAI_APPS_CHALLENGE_TOKEN=

# Exact values assigned to the Context7 Vercel Marketplace product.
VERCEL_MARKETPLACE_OIDC_ISSUER=
VERCEL_MARKETPLACE_OIDC_AUDIENCE=

# Required for hosted HTTP deployments. Must match context7.com.
MCP_CLIENT_IP_ASSERTION_KEY=
# Defaults to required. Set observe to accept requests without credentials on
# /mcp and record them, for example during a migration.
MCP_AUTH_ENFORCEMENT=
# Set off to forward opaque OAuth tokens (oat_…) without checking them against
# the Context7 API first.
MCP_OAUTH_TOKEN_VALIDATION=
# Audience check for OAuth JWT access tokens from OAUTH_AUTH_SERVER_URL.
# observe (default): a token whose aud is missing or not allowed is accepted
# and logged as audienceMismatch (clientId, aud). required: it gets HTTP 401.
# Flip back to observe to roll back.
MCP_OAUTH_AUDIENCE_ENFORCEMENT=
# Comma-separated allowed audiences, normalized (lowercase scheme and host, no
# trailing slash) before comparison. Defaults to the RESOURCE_URL origin plus
# its /mcp and /mcp/oauth paths, e.g.
# https://mcp.context7.com,https://mcp.context7.com/mcp,https://mcp.context7.com/mcp/oauth
MCP_OAUTH_ALLOWED_AUDIENCES=

# Network / certificates
HTTPS_PROXY=
NODE_EXTRA_CA_CERTS=

# GitHub integration
GITHUB_TOKEN=
GH_TOKEN=

# CLI behavior
CLAUDE_CONFIG_DIR=
CTX7_TELEMETRY_DISABLED=
EDITOR=
